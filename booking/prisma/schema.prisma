// BookIt data model — Sprint 1 starts with User (SPEC.md §5).
// Later sprints add Service, Availability, Appointment.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  PROVIDER
  ADMIN
}

model User {
  id           String    @id @default(cuid())
  email        String    @unique
  passwordHash String
  name         String
  role         Role      @default(CUSTOMER)
  createdAt    DateTime  @default(now())
  services     Service[]
  availability Availability[]
}

model Availability {
  id         String @id @default(cuid())
  providerId String
  provider   User   @relation(fields: [providerId], references: [id])
  weekday    Int // 0..6 (Sunday..Saturday), provider-local
  startMin   Int // minutes from midnight
  endMin     Int

  @@index([providerId])
}

model Service {
  id          String   @id @default(cuid())
  providerId  String
  provider    User     @relation(fields: [providerId], references: [id])
  name        String
  description String   @default("")
  category    String
  durationMin Int
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())

  @@index([category])
  @@index([providerId])
}
